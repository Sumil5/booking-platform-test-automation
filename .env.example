# Copy to .env (git-ignored) and fill in, or export these as environment variables.
# Lookup order: JVM system property (-DKEY=...) > environment variable > .env file.

# Base URL of the Restful-Booker-Platform deployment, without a trailing slash.
BASE_URL=https://automationintesting.online

# Admin credentials for POST /api/auth/login.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional tuning
# HTTP_TIMEOUT_MS=15000
# TOKEN_REVALIDATE_SECONDS=60
